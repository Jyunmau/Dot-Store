# Dot-Store 环境变量配置模板

# 数据库配置
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dot_store
DB_PORT=5432

# API 服务配置
API_PORT=8000
API_HOST=localhost
APP_DEBUG=false
LOG_LEVEL=INFO

# 前端服务配置
FRONTEND_PORT=80

# 注意：请不要将此文件中的敏感信息直接用于生产环境
# 在生产环境中，请创建一个 .env 文件并修改以下敏感信息
# 例如：
# DB_PASSWORD=your_strong_password
# 并将 .env 文件添加到 .gitignore 中，避免将敏感信息提交到版本控制系统